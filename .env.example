# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.134
# Required when DJANGO_DEBUG=false (full URL with scheme and port)
# DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://192.168.1.134:8000
DJANGO_HTTP_PORT=8000

# Database — SQLite by default; set NADIR_DB_HOST for external PostgreSQL
# NADIR_DATABASE_URL=postgresql://nadir_user:<password>@127.0.0.1:5432/nadir_db
# NADIR_DB_HOST=127.0.0.1
# NADIR_DB_PORT=5432
# NADIR_DB_NAME=nadir_db
# NADIR_DB_USER=nadir_user
# NADIR_DB_PASSWORD=<your-postgres-password>

# Inference bind address (127.0.0.1 recommended; gateway proxies to clients)
MLX_DEFAULT_SERVER_HOST=127.0.0.1

# Background health polling (seconds)
MLX_HEALTH_INTERVAL_SECONDS=30
MLX_RESTART_BACKOFF_SECONDS=30
MLX_INSTANCE_WATCHDOG_ENABLED=true
# Max seconds to wait for an inference port to free after stop (default 12)
MLX_STOP_PORT_RELEASE_TIMEOUT_SECONDS=12

# Nadir Gateway (OpenAI-compatible proxy, outside instance range 11400-11500)
# Loaded automatically from .env via mlx_orchestrator.settings (override=False).
NADIR_GATEWAY_HOST=127.0.0.1
NADIR_GATEWAY_PORT=11380
# Required when NADIR_GATEWAY_HOST is not loopback (LAN bind).
# NADIR_GATEWAY_API_KEY=change-me
# Optional auth for Nadir inference workers (image/stt/embedding/tts). Gateway injects it upstream.
# NADIR_INFERENCE_API_KEY=change-me
# Comma-separated browser Origins allowed to call the gateway (empty = reject any Origin).
# NADIR_GATEWAY_CORS_ORIGINS=http://127.0.0.1:8000
# Extra Host values for TrustedHostMiddleware (beyond localhost/127.0.0.1/[::1]).
# NADIR_GATEWAY_ALLOWED_HOSTS=192.168.1.134
# Reject bodies larger than this many MiB (Content-Length).
NADIR_GATEWAY_MAX_BODY_MB=50
NADIR_GATEWAY_PROXY_TIMEOUT_SECONDS=300
NADIR_GATEWAY_MAX_CONCURRENT_UPSTREAM=16
NADIR_GATEWAY_QUEUE_TIMEOUT_SECONDS=300
NADIR_GATEWAY_ROUTE_CACHE_TTL_SECONDS=20
NADIR_GATEWAY_WAKE_TIMEOUT_SECONDS=300
NADIR_GATEWAY_WAKE_POLL_INTERVAL_SECONDS=1
# Refresh last_used_at during long JSON / SSE (incl. mlx-lm prefill).
NADIR_GATEWAY_ACTIVITY_HEARTBEAT_SECONDS=15
NADIR_IDLE_OFFLOAD_ENABLED=true
NADIR_IDLE_CHECK_INTERVAL_SECONDS=60
NADIR_LRU_EVICTION_ENABLED=true
# Min idle age before LRU eviction (floored to 2 × activity heartbeat).
NADIR_LRU_EVICTION_GRACE_SECONDS=60
NADIR_MEMORY_RESERVE_GB=4
NADIR_GATEWAY_PUBLIC_BASE_URL=http://127.0.0.1:11380

# Nadir MCP (Streamable HTTP — IDE instance control)
# python manage.py run_mcp  →  http://127.0.0.1:11381/mcp
NADIR_MCP_HOST=127.0.0.1
NADIR_MCP_PORT=11381
NADIR_MCP_PATH=/mcp
NADIR_MCP_ENABLED=true
# NADIR_MCP_API_KEY=change-me
# Extra Host values when MCP is not on loopback:
# NADIR_MCP_ALLOWED_HOSTS=192.168.1.134

# Benchmark custom endpoints (anti-SSRF). Disabled when DJANGO_DEBUG=false unless explicitly enabled.
# NADIR_BENCHMARK_ENDPOINT_ENABLED=true
# NADIR_BENCHMARK_ENDPOINT_ALLOWED_HOSTS=127.0.0.1,localhost,::1
IMAGE_OUTPUT_TTL_SECONDS=3600

# Set to 1 during tests or one-off management commands
# MLX_DISABLE_INSTANCE_WATCHDOG=1
